<% if (title) { %>
  <div>
    <h1 style="margin-left: 20px;"><%= title %></h1>
    <h1><%- messages() %></h1>
    <% if (errors) { %>
    <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
    </ul>
    <% } %>
  </div>
<% } else {
  res.redirect('/')
} %>

<form action="/account/register" method="post" id="formRegister">
    <div class="login-register-container">
        <label for="firstName">First Name:</label>        
        <input type="text" name="account_firstname" id="accountFirstname" required value="<%= locals.account_firstname %>" placeholder="Your first name">

        <label for="lastName">Last Name:</label>
        <input type="text" id="account_lastname" placeholder="Your last name" name="account_lastname" required value="<%= locals.account_lastname %>">

        <label for="email">Email:</label>
        <input type="email" id="account_email" placeholder="Enter a valid email" name="account_email" required value="<%= locals.account_email %>">

        <label for="password">Password:</label>    
        <input type="password" name="account_password" id="accountPassword" required pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$">
        <span>Passwords must be at least 12 characters and contain at least 1 number, 1 capital letter and 1 special character</span> 

        <div class="login-register-button">    
            <button type="submit">Register</button>
        </div>
    </div>
</form>