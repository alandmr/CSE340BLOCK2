<% if (title) { %>
  <div>
    <h1 style="margin-left: 20px;"><%= title %></h1>
    <h1><%- messages() %></h1>           
    <% if (errors) { %>
    <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
    </ul>
    <% } %>
  </div>    
<% } else {
  res.redirect('/')
} %>



<script>
  setTimeout(() => {
    window.location.href = "<%= redirectTo %>";
  }, 1500);
</script>

