<% if (title) { %>
  <div class="account-Management">
    <h1><%= title %></h1>
    <% if (messages()){ %>
      <h1><%- messages() %></h1>
    <% } %> 
    <h2>Welcome <%- userName %></h2>  
    <span>You're logged in. </span>  
    <div class="account-mgnt-edit"><%- clientAdminOptions %></div>
    
    <% if (errors) { %>
    <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
    </ul>
    <% } %>
  </div>    
<% } else {
  res.redirect('/')
} %>

