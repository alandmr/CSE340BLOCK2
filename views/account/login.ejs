<% if (title) { %>
  <div>
    <h1 style="margin-left: 20px;"><%= title %></h1>
    <!-- <h1><%- messages() %></h1> -->
    <% if (errors) { %>
    <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
    </ul>
    <% } %>
  </div>    
<% } else {
  res.redirect('/')
} %>

<form action="/account/login" method="post" id="formLogin">
  <div class="login-register-container">
    <label for="email">Email:</label>
    <input type="email" id="email" placeholder="Enter a valid email" name="account_email" required>

    <label for="accountPassword">Password:</label>    
    <input type="password" name="account_password" id="accountPassword" required pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$">
    <span>Passwords must be at least 12 characters and contain at least 1 number, 1 capital letter and 1 special character</span>

    <div class="login-register-button">
        <button type="submit">LOGIN</button>
    </div>

    <div class="signUpLink">
        No account? <a href="/account/register">Sign-up</a>
    </div>
  </div>
</form>
